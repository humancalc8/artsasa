  "fields": {
    "title": "After the Rain",
    "slug": "after-the-rain",
    "artist": 2,
    "category": 1,
    "image": "artworks/After_The_Rain_Painting_by_Dodi_Ballada___ArtMajeur.jfif",
    "short_description": "A quiet photographic meditation on Nairobi streets moments after rainfall.",
    "description": "After the Rain captures the brief transformation of an urban street following a heavy afternoon shower. Reflections, passing figures and softened architectural forms create a scene that feels both familiar and fleeting. The photograph is part of an ongoing body of work examining everyday moments within rapidly changing African cities.",
