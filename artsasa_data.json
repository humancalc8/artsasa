{
  "model": "app.artwork",
  "pk": 1,
  "fields": {
    "title": "Quiet Ground",
    "slug": "quiet-ground",
    "artist": 1,
    "category": 3,
    "image": "artworks/Golden_Echoes__A_Study_of_Inner_Peace__Ancestral_Presence.jfif",
    "short_description": "A restrained study of ochre, shadow and memory, exploring the emotional landscape of a familiar place.",
    "description": "Quiet Ground considers the relationship between landscape and memory. Layers of oil and earth pigment are worked slowly across the canvas, allowing traces of earlier marks to remain visible beneath the surface. The warm, muted palette gives the work a sense of stillness, while subtle changes in texture suggest a landscape remembered rather than directly observed.",
    "medium": "Oil and earth pigment on canvas",
    "year": 2026,
    "dimensions": "90 × 120 cm",
    "edition": "Unique work",
    "price": "185000.00",
